# ─────────────────────────────────────────────
# Stock Monitor — environment variables template
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────
# Create a bot via @BotFather on Telegram.
# 1. Message @BotFather → /newbot → follow prompts → copy the token below.
# 2. Start a chat with your new bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321

# ── Email alerts (optional) ───────────────────
# Only needed for alerts you ask to receive by mail ("תתריע לי במייל כש...").
# Everything else works without these. Set ONE of the two blocks below.
#
# (A) Resend — an HTTPS API on port 443. The only one that works on Render's
#     free plan, which blocks outbound SMTP on 25, 465 AND 587.
#     Sign up at https://resend.com with the address you want alerts sent to:
#     without a verified domain, Resend delivers only to the account's own
#     address. Then API Keys -> Create API Key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to Resend's shared sender, which needs no domain. Set it
# only once you have verified a domain of your own with them.
# RESEND_FROM=alerts@yourdomain.com
#
# (B) SMTP — for a local run, a paid Render instance, or any other host.
#     Gmail refuses a plain account password (error 535): enable two-factor
#     authentication, then create an App Password at
#     https://myaccount.google.com/apppasswords
#     Port 587 is STARTTLS (the default), 465 is implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
#
# Where the alerts go, for either provider. Defaults to SMTP_USER when unset.
ALERT_EMAIL_TO=you@gmail.com

# ── Discord Webhook ───────────────────────────
# In Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXX/YYYYYYYYYYY

# ── TradingView Webhook Secret ────────────────
# Any random string you choose. Enter the same value in your TradingView
# alert's "Webhook URL" message body as {"secret": "YOUR_SECRET_HERE", ...}
# OR configure HMAC signing below.
TRADINGVIEW_WEBHOOK_SECRET=change_me_to_a_random_string

# ── Anthropic API (AI stock analysis) ────────
# Create a key at https://console.anthropic.com/
# Then set ai.enabled: true in config/config.yaml
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Tiingo (live prices) ──────────────────────
# Yahoo rate-limits shared datacenter IPs, and when it does it serves the
# *previous* session's prices with a 200 rather than an error — the portfolio
# silently shows yesterday's numbers. Tiingo is the live-price source when this
# is set; Yahoo still supplies history, ATR and fundamentals.
# Free key: https://www.tiingo.com/ → sign up → API → Token.
# Leave unset to keep Yahoo as the only source.
# TIINGO_API_KEY=your-tiingo-token

# ── PostgreSQL (optional) ─────────────────────
# When set, alert history and portfolio positions are persisted and survive
# restarts and redeploys. When unset, both are kept in memory only.
# Render / Supabase / Neon connection strings work as-is.
#
# IPv6: managed providers publish AAAA records, and many container hosts
# (Render among them) have no IPv6 egress — the connection then fails with
# "Network is unreachable" before any credential is checked. The app detects
# that and retries pinned to the host's IPv4 address. If a host has no IPv4
# record at all, use the provider's pooled endpoint instead (Neon: the
# hostname containing "-pooler").
# DATABASE_URL=postgresql://user:password@host:5432/stocktracker

# ── Dashboard login (required for public deployments) ─────────
# When both are set, the dashboard, API and /docs require this login.
# When unset, no login is required (fine for local use only).
# DASHBOARD_USER=myname
# DASHBOARD_PASSWORD=choose-a-long-random-password
