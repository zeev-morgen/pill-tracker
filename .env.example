# ─────────────────────────────────────────────
# Stock Monitor — environment variables template
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────
# Create a bot via @BotFather on Telegram.
# 1. Message @BotFather → /newbot → follow prompts → copy the token below.
# 2. Start a chat with your new bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321

# ── Discord Webhook ───────────────────────────
# In Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXX/YYYYYYYYYYY

# ── TradingView Webhook Secret ────────────────
# Any random string you choose. Enter the same value in your TradingView
# alert's "Webhook URL" message body as {"secret": "YOUR_SECRET_HERE", ...}
# OR configure HMAC signing below.
TRADINGVIEW_WEBHOOK_SECRET=change_me_to_a_random_string
