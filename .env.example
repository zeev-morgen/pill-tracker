# ─────────────────────────────────────────────
# Stock Monitor — environment variables template
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────
# Create a bot via @BotFather on Telegram.
# 1. Message @BotFather → /newbot → follow prompts → copy the token below.
# 2. Start a chat with your new bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321

# ── Discord Webhook ───────────────────────────
# In Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXX/YYYYYYYYYYY

# ── TradingView Webhook Secret ────────────────
# Any random string you choose. Enter the same value in your TradingView
# alert's "Webhook URL" message body as {"secret": "YOUR_SECRET_HERE", ...}
# OR configure HMAC signing below.
TRADINGVIEW_WEBHOOK_SECRET=change_me_to_a_random_string

# ── Anthropic API (AI stock analysis) ────────
# Create a key at https://console.anthropic.com/
# Then set ai.enabled: true in config/config.yaml
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── PostgreSQL (optional) ─────────────────────
# When set, alert history and portfolio positions are persisted and survive
# restarts and redeploys. When unset, both are kept in memory only.
# Render / Supabase / Neon connection strings work as-is.
# DATABASE_URL=postgresql://user:password@host:5432/stocktracker

# ── Dashboard login (required for public deployments) ─────────
# When both are set, the dashboard, API and /docs require this login.
# When unset, no login is required (fine for local use only).
# DASHBOARD_USER=myname
# DASHBOARD_PASSWORD=choose-a-long-random-password
